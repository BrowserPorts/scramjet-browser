{
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"lib": ["ES2023", "dom", "dom.iterable"],
		"types": ["node"],
		"strict": true,
		"noImplicitAny": false,
		"skipLibCheck": true,
		"declaration": true,
		"sourceMap": true,
		"inlineSources": true,
		"outDir": "dist",
		"rootDir": "src",
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*.ts"]
}
