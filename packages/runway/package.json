{
	"name": "runway",
	"version": "2.0.0",
	"description": "Runway: Playwright-driven Scramjet conformance runner with versioned result records",
	"type": "module",
	"license": "AGPL-3.0-only",
	"author": "Mercury Workshop",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MercuryWorkshop/scramjet.git",
		"directory": "packages/runway"
	},
	"engines": {
		"node": ">=22.6.0"
	},
	"bin": {
		"runway": "./dist/cli/bin.js"
	},
	"main": "./dist/public.js",
	"types": "./dist/public.d.ts",
	"exports": {
		".": {
			"types": "./dist/public.d.ts",
			"default": "./dist/public.js"
		},
		"./testkit": {
			"types": "./dist/testkit.d.ts",
			"default": "./dist/testkit.js"
		},
		"./plugin-api": {
			"types": "./dist/plugin-api.d.ts",
			"default": "./dist/plugin-api.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"examples/plugins",
		"examples/tests",
		"expectations.json",
		"CONSUMER_GUIDE.md",
		"PLUGIN_TESTING.md"
	],
	"scripts": {
		"build": "node build.mjs",
		"check-package": "node scripts/check-package.mjs",
		"cli": "node --experimental-strip-types --no-warnings src/cli/bin.ts",
		"list": "node --experimental-strip-types --no-warnings src/cli/bin.ts list",
		"preflight": "node --experimental-strip-types --no-warnings src/cli/bin.ts preflight",
		"prepack": "node build.mjs",
		"run:tests": "node --experimental-strip-types --no-warnings src/cli/bin.ts run",
		"test": "node --experimental-strip-types --no-warnings src/cli/bin.ts run --suite native",
		"typecheck": "tsc --noEmit",
		"test:unit": "node --experimental-strip-types --no-warnings --test test/*.test.mjs"
	},
	"dependencies": {
		"@mercuryworkshop/scramjet": "workspace:*",
		"@mercuryworkshop/scramjet-controller": "workspace:*",
		"@mercuryworkshop/wisp-js": "catalog:",
		"commander": "^14.0.2",
		"playwright": "1.61.0",
		"send": "^0.19.0",
		"serve-static": "^1.16.2",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@types/node": "^22.0.0",
		"@types/send": "^0.17.6",
		"@types/serve-static": "^1.15.10",
		"@types/ws": "^8.18.1",
		"publint": "^0.3.24",
		"typescript": "^5.9.3"
	},
	"keywords": [
		"scramjet",
		"wpt",
		"playwright",
		"conformance"
	],
	"packageManager": "pnpm@10.12.1"
}
