{
	"name": "@mercuryworkshop/rpc",
	"version": "0.1.0-stellite.2",
	"type": "module",
	"packageManager": "pnpm@10.12.1",
	"license": "AGPL-3.0-only",
	"main": "./index.ts",
	"module": "./index.ts",
	"types": "./index.ts",
	"exports": {
		".": {
			"types": "./index.ts",
			"default": "./index.ts"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"module": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./package.json": "./package.json"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc --project tsconfig.json",
		"prepack": "pnpm build"
	},
	"devDependencies": {
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@mercuryworkshop/proxy-transports": "catalog:"
	}
}
