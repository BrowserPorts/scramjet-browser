{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": [],
		"strict": false,
		"skipLibCheck": true,
		"declaration": true,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": ".",
		"forceConsistentCasingInFileNames": true
	},
	"include": ["index.ts"]
}
