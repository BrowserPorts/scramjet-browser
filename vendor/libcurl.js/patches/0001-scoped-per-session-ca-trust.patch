     curl_slist_free_all(request_info->headers_list);
+    request_info->headers_list = NULL;
   }
   (*request_info->end_callback)(request_info->request_id, error);
+}
+
+//Scopes one UNSTARTED handle to an additional CA bundle, at most once.
+//
+//Returns the profile id on success, or 0 on any failure, having changed nothing:
+//no option is touched and no reference is taken until every precondition holds,
+//so a failure leaves the caller with only the unstarted handle to destroy.
+//
+//Refusals: unknown profile; a handle that is already started, because its
+//connection may exist and its trust must not change under it; and a handle that
+//already carries a profile, because reassigning would leak the first reference
+//and silently widen or narrow trust.
+int request_set_trust_profile(CURL* http_handle, int profile_id) {
+  struct RequestInfo *request_info = get_request_info(http_handle);
+  if (request_info->started) return 0;
+  if (request_info->trust_profile != 0) return 0;
+
+  struct curl_blob* blob = trust_profile_blob(profile_id);
+  if (blob == NULL) return 0;
+
+  //Replaces the anchor set for this handle only; every other check stays on.
+  if (curl_easy_setopt(http_handle, CURLOPT_CAINFO_BLOB, blob) != CURLE_OK) {
+    return 0;
+  }
+  //A scoped handle must not follow redirects internally: curl would carry the
+  //anchor set to whatever host the response points at. This is a deliberate
+  //restriction on scoped requests, not a reproduction of fetch semantics; the
+  //caller drives the hops.
+  if (curl_easy_setopt(http_handle, CURLOPT_FOLLOWLOCATION, 0L) != CURLE_OK) {
+    return 0;
+  }
+
+  if (!trust_profile_retain(profile_id)) return 0;
+  request_info->trust_profile = profile_id;
+  return profile_id;
 }
 
