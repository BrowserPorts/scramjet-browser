+//---- scoped trust profiles -------------------------------------------------
+//
+// An additional CA bundle a caller may scope to specific hosts. Verification is
+// not weakened: CURLOPT_CAINFO_BLOB substitutes the trust ANCHOR SET only, so
+// mbedTLS still builds the chain, enforces the validity period and matches
+// hostname and SNI. VERIFYPEER and VERIFYHOST are never touched.
+//
+// Lifetime. Profiles are immutable. The session that created one holds a
+// reference and each easy handle that uses it borrows another, so the bytes
+// outlive every handle that verified against them. CURL_BLOB_COPY is used, so
+// curl keeps its own copy and nothing depends on our buffer surviving a handle.
+//
+// The byte bound below covers THIS REGISTRY ONLY. It does not bound the copies
+// curl makes per handle, nor the allocations mbedTLS makes per connection.
+
+#define MAX_TRUST_PROFILES 8
+#define MAX_TRUST_PEM_BYTES (1 << 20)
+#define MAX_TRUST_REGISTRY_BYTES (4 << 20)
+
+struct TrustProfile {
+  int id;
+  unsigned char* pem;
+  int pem_len;
+  int refs;
+  struct curl_blob blob;
+};
+
+static struct TrustProfile trust_profiles[MAX_TRUST_PROFILES];
+static int trust_next_id = 1;
+static int trust_registry_bytes = 0;
+
+static struct TrustProfile* trust_profile_find(int profile_id) {
+  if (profile_id <= 0) return NULL;
+  for (int i = 0; i < MAX_TRUST_PROFILES; i++) {
+    if (trust_profiles[i].id == profile_id && trust_profiles[i].refs > 0) {
+      return &trust_profiles[i];
+    }
+  }
+  return NULL;
+}
+
+//Returns a monotonic profile id owned by the caller (one reference), or 0.
+int trust_profile_create(const char* pem) {
+  if (pem == NULL) return 0;
+  size_t len = strlen(pem);
+  if (len == 0 || len > MAX_TRUST_PEM_BYTES) return 0;
+  if (trust_registry_bytes + (int) len > MAX_TRUST_REGISTRY_BYTES) return 0;
+
+  struct TrustProfile* slot = NULL;
+  for (int i = 0; i < MAX_TRUST_PROFILES; i++) {
+    if (trust_profiles[i].refs == 0) {
+      slot = &trust_profiles[i];
+      break;
+    }
+  }
+  if (slot == NULL) return 0;
+
+  unsigned char* owned = malloc(len + 1);
+  if (owned == NULL) return 0;
+  memcpy(owned, pem, len);
+  owned[len] = 0;
+
+  slot->id = trust_next_id++;
+  slot->pem = owned;
+  slot->pem_len = (int) len;
+  slot->refs = 1;
+  slot->blob.data = owned;
+  slot->blob.len = len;
+  slot->blob.flags = CURL_BLOB_COPY;
+  trust_registry_bytes += (int) len;
+
+  return slot->id;
+}
+
+struct curl_blob* trust_profile_blob(int profile_id) {
+  struct TrustProfile* profile = trust_profile_find(profile_id);
+  return profile == NULL ? NULL : &profile->blob;
+}
+
+int trust_profile_retain(int profile_id) {
+  struct TrustProfile* profile = trust_profile_find(profile_id);
+  if (profile == NULL) return 0;
+  profile->refs++;
+  return profile_id;
+}
+
+//Drops one reference. Frees and reclaims the slot at zero; ids are never reused.
+int trust_profile_release(int profile_id) {
+  struct TrustProfile* profile = trust_profile_find(profile_id);
+  if (profile == NULL) return 0;
+  if (--profile->refs == 0) {
+    trust_registry_bytes -= profile->pem_len;
+    free(profile->pem);
+    profile->pem = NULL;
+    profile->pem_len = 0;
+    profile->id = 0;
+  }
+  return 1;
+}
+
+int trust_profile_live_count() {
+  int live = 0;
+  for (int i = 0; i < MAX_TRUST_PROFILES; i++) {
+    if (trust_profiles[i].refs > 0) live++;
+  }
+  return live;
+}
+
+int trust_profile_refs(int profile_id) {
+  struct TrustProfile* profile = trust_profile_find(profile_id);
+  return profile == NULL ? 0 : profile->refs;
+}
+
